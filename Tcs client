RunService.RenderStepped:Connect(function(dt)
	local closest = ScanForClosestTPSBall()
	if closest ~= CurrentBall then
		CurrentBall = closest
		if CurrentBall then
			if BallPresets[CurrentBallPresetIndex].Name ~= "Padrão" then ApplyBallSkin(BallPresets[CurrentBallPresetIndex]) end
			if BallColorPresets[CurrentBallColorIndex].Name ~= "Padrão" then ApplyBallColor(BallColorPresets[CurrentBallColorIndex]) end
		end
	end

	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local rightLeg = char and (char:FindFirstChild("Right Leg") or char:FindFirstChild("RightFoot") or char:FindFirstChild("Torso") or hrp)

	-- 1. CALCULAR DIREÇÃO DO ANALÓGICO VIRTUAL
	local analogDir = Vector3.new(0, 0, 0)
	local isAnalogActive = VirtualAnalogEnabled and DraggingAnalog and AnalogMoveVector.Magnitude > 0.1
	if isAnalogActive then
		local cam = Workspace.CurrentCamera
		local forward = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		if forward.Magnitude > 0 then forward = forward.Unit end
		local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
		if right.Magnitude > 0 then right = right.Unit end
		
		analogDir = (forward * -AnalogMoveVector.Z) + (right * AnalogMoveVector.X)
		if analogDir.Magnitude > 0.001 then
			analogDir = analogDir.Unit
		end
	end

	-- Controle de zonas
	local inReachBallZone = false
	local inReachZone = false
	local insideAnyZone = false

	if EspBallEnabled and CurrentBall then
		BallHighlight.Adornee = CurrentBall
		BallHighlight.Enabled = true
		BallEspSphere.Size = CurrentBall.Size
		BallEspSphere.Position = CurrentBall.Position
		BallEspSphere.Parent = Workspace
		BallNameGui.Adornee = CurrentBall
		BallNameGui.Enabled = true
		TrailAtt0.WorldPosition = CurrentBall.Position + Vector3.new(0, 1.2, 0)
		TrailAtt1.WorldPosition = CurrentBall.Position - Vector3.new(0, 1.2, 0)
		BallTrail.Enabled = true
	else
		BallHighlight.Enabled = false
		BallEspSphere.Parent = nil
		BallNameGui.Enabled = false
		BallTrail.Enabled = false
	end

	if CurrentBall then
		local ballPos = CurrentBall.Position

		if ReachBallEnabled then
			ZonePart.Parent = Workspace
			if ZoneVisualMode == "3D" then
				ZonePart.Size = ReachBallSize
				ZonePart.CFrame = CFrame.new(ballPos)
				ZoneBox.Parent = Workspace
				ZoneBox.Visible = true
			elseif ZoneVisualMode == "2D" then
				ZonePart.Size = Vector3.new(ReachBallSize.X, 0.1, ReachBallSize.Z)
				ZonePart.CFrame = CFrame.new(ballPos.X, ballPos.Y, ballPos.Z)
				ZoneBox.Parent = Workspace
				ZoneBox.Visible = true
			else
				ZoneBox.Visible = false
			end
		else
			ZonePart.Parent = nil
			ZoneBox.Parent = nil
		end

		if ReachEnabled then
			CustomHitbox.Parent = Workspace
			if ZoneVisualMode == "3D" then
				CustomHitbox.Size = ReachSize
				CustomHitbox.CFrame = CFrame.new(ballPos)
				HitboxBox.Parent = Workspace
				HitboxBox.Visible = true
			elseif ZoneVisualMode == "2D" then
				CustomHitbox.Size = Vector3.new(ReachSize.X, 0.1, ReachSize.Z)
				CustomHitbox.CFrame = CFrame.new(ballPos.X, ballPos.Y, ballPos.Z)
				HitboxBox.Parent = Workspace
				HitboxBox.Visible = true
			else
				HitboxBox.Visible = false
			end
			HitboxBox.Color3 = ReachColor
			HitboxBox.SurfaceColor3 = ReachColor
		else
			CustomHitbox.Parent = nil
			HitboxBox.Parent = nil
		end

		if ReachEnabled and rightLeg and IsPlayerInZone(ballPos, rightLeg.Position, ReachSize) then
			if firetouchinterest then
				firetouchinterest(rightLeg, CurrentBall, 0)
				task.spawn(function()
					task.wait()
					firetouchinterest(rightLeg, CurrentBall, 1)
				end)
			end
		end

		inReachBallZone = ReachBallEnabled and hrp and IsPlayerInZone(ballPos, hrp.Position, ReachBallSize)
		inReachZone = ReachEnabled and hrp and IsPlayerInZone(ballPos, hrp.Position, ReachSize)
		insideAnyZone = inReachBallZone or inReachZone

		if AutoSwagEnabled then TriggerAutoSwag() end

		if BallPredictEnabled then
			if CurrentBall.AssemblyLinearVelocity.Magnitude > 1.5 then
				PredictCircle.Parent = Workspace
				PredictCircle.CFrame = CFrame.new(CalculateLandingPosition(CurrentBall)) * CFrame.Angles(0, 0, math.rad(90))
			else
				PredictCircle.Parent = nil
			end
		else
			PredictCircle.Parent = nil
		end
	else
		ZonePart.Parent = nil
		ZoneBox.Parent = nil
		CustomHitbox.Parent = nil
		HitboxBox.Parent = nil
		PredictCircle.Parent = nil
	end

	-- 2. LÓGICA DE MOVIMENTO (AutoBall sem oscilação)
	if AutoBallEnabled and humanoid and hrp and CurrentBall then
		local shouldFollow = ReachBallEnabled and inReachBallZone or not ReachBallEnabled

		if shouldFollow then
			local ballPos = CurrentBall.Position
			local ballVel = CurrentBall.AssemblyLinearVelocity
			local mode = AutoBallModes[AutoBallModeIndex]
			local targetPos = ballPos

			if mode == "Predict" then
				local landPos = CalculateLandingPosition(CurrentBall)
				local speedHorizontal = Vector3.new(ballVel.X, 0, ballVel.Z).Magnitude
				targetPos = speedHorizontal > 2 and (landPos + (Vector3.new(ballVel.X, 0, ballVel.Z) * 0.3)) or landPos
			elseif mode == "Frente" then
				local horizVel = Vector3.new(ballVel.X, 0, ballVel.Z)
				targetPos = horizVel.Magnitude > 1.5 and (ballPos + (horizVel.Unit * 6)) or (ballPos + (hrp.CFrame.LookVector * 4))
			elseif mode == "Atras" then
				local horizVel = Vector3.new(ballVel.X, 0, ballVel.Z)
				if horizVel.Magnitude > 1 then
					targetPos = ballPos - (horizVel.Unit * 0.8)
				else
					targetPos = ballPos - (hrp.CFrame.LookVector * 0.8)
				end
			end

			local moveDir = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
			local distance = moveDir.Magnitude
			local autoBallMoveVector = Vector3.new(0, 0, 0)

			---------------------------------------------------------
			-- LÓGICA DE STUDS CORRIGIDA (SEM RECUO/OSCILAÇÃO)
			---------------------------------------------------------
			if distance > StudsBallDistance then
				autoBallMoveVector = moveDir.Unit
			else
				-- Quando chega na distância limite, apenas PARA totalmente.
				autoBallMoveVector = Vector3.new(0, 0, 0)
			end

			-- INTERFERÊNCIA DO ANALÓGICO:
			local finalMoveDir = autoBallMoveVector
			if isAnalogActive then
				local interferenceWeight = math.clamp(AnalogInterference / 100, 0, 1)
				if autoBallMoveVector.Magnitude > 0.001 then
					finalMoveDir = autoBallMoveVector:Lerp(analogDir, interferenceWeight)
				else
					finalMoveDir = analogDir
				end

				if finalMoveDir.Magnitude > 0.001 then
					finalMoveDir = finalMoveDir.Unit
				end
			end

			ProcessMovement(humanoid, finalMoveDir, dt)
			wasControlling = true

			StatusLabel.Text = "Status: Auto Ball (" .. mode .. " | " .. MovementModes[MovementModeIndex] .. ")"
			StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
		else
			-- Permite que o analógico tome o controle se o jogador tentar andar fora da zona
			if isAnalogActive then
				ProcessMovement(humanoid, analogDir, dt)
				StatusLabel.Text = "Status: Movimento Manual (Fora da Zona)"
				StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
			else
				ProcessMovement(humanoid, Vector3.new(0, 0, 0), dt)
				StatusLabel.Text = "Status: Aguardando Entrar na Zona!"
				StatusLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
			end
			wasControlling = true
		end

	elseif isAnalogActive and humanoid then
		-- MOVIMENTO MANUAL COM ANALÓGICO
		ProcessMovement(humanoid, analogDir, dt)
		wasControlling = true
		
		if not AutoBallEnabled then
			StatusLabel.Text = "Status: Movimento Manual (" .. MovementModes[MovementModeIndex] .. ")"
			StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
		end

	else
		-- DEVOLVE O CONTROLE ORIGINAL (WASD / TECLADO NATIVO)
		if wasControlling then
			wasControlling = false
			CurrentMoveVector = Vector3.new(0, 0, 0)
		end

		-- ATUALIZAÇÃO DA HUD DE STATUS
		if not CurrentBall then
			StatusLabel.Text = "Status: Procurando Bola Mais Próxima..."
			StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		elseif not AutoBallEnabled then
			StatusLabel.Text = "Status: Bola Próxima Detectada (" .. CurrentBall.Name .. ")"
			StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
		end
	end
end)

