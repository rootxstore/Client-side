		if ReachEnabled then
			CustomHitbox.Parent=Workspace
			if zvm=="3D" then CustomHitbox.Size=ReachSize; CustomHitbox.CFrame=CFrame.new(bp); HitboxBox.Parent=Workspace; HitboxBox.Visible=true
			elseif zvm=="2D" then CustomHitbox.Size=Vector3.new(ReachSize.X,0.1,ReachSize.Z); CustomHitbox.CFrame=CFrame.new(bp.X,bp.Y,bp.Z); HitboxBox.Parent=Workspace; HitboxBox.Visible=true
			else HitboxBox.Visible=false end
			HitboxBox.Color3=ReachColor; HitboxBox.SurfaceColor3=ReachColor
		else CustomHitbox.Parent=nil; HitboxBox.Parent=nil end

		if ReachEnabled and rightLeg and IsInZone(bp,rightLeg.Position,ReachSize) then
			if firetouchinterest then
				firetouchinterest(rightLeg,CurrentBall,0)
				task.spawn(function() task.wait(); firetouchinterest(rightLeg,CurrentBall,1) end)
			end
		end

		inRBZone=ReachBallEnabled and hrp and IsInZone(bp,hrp.Position,ReachBallSize)
		inRZone=ReachEnabled and hrp and IsInZone(bp,hrp.Position,ReachSize)

		if AutoSwagEnabled then TriggerAutoSwag() end

		if BallPredictEnabled and CurrentBall.AssemblyLinearVelocity.Magnitude>1.5 then
			PredictCircle.Parent=Workspace
			PredictCircle.CFrame=CFrame.new(CalcLanding(CurrentBall))*CFrame.Angles(0,0,math.rad(90))
		else PredictCircle.Parent=nil end
	else
		ZonePart.Parent=nil; ZoneBox.Parent=nil; CustomHitbox.Parent=nil; HitboxBox.Parent=nil; PredictCircle.Parent=nil
	end

	if AutoBallEnabled and humanoid and hrp and CurrentBall then
		local shouldFollow=not ReachBallEnabled or inRBZone
		if shouldFollow then
			local bp=CurrentBall.Position; local bv=CurrentBall.AssemblyLinearVelocity
			local mode=AutoBallModes[GetABModeIdx()]; local tp=bp
			if mode=="Predict" then
				local land=CalcLanding(CurrentBall); local sh=Vector3.new(bv.X,0,bv.Z).Magnitude
				tp=sh>2 and (land+Vector3.new(bv.X,0,bv.Z)*0.3) or land
			elseif mode=="Frente" then
				local hv=Vector3.new(bv.X,0,bv.Z); tp=hv.Magnitude>1.5 and (bp+hv.Unit*6) or (bp+hrp.CFrame.LookVector*4)
			elseif mode=="Atras" then
				local hv=Vector3.new(bv.X,0,bv.Z); tp=hv.Magnitude>1 and (bp-hv.Unit*0.8) or (bp-hrp.CFrame.LookVector*0.8)
			end

			local md=Vector3.new(tp.X-hrp.Position.X,0,tp.Z-hrp.Position.Z)
			local dist2d=md.Magnitude
			local now=tick()

			-- hysteresis + lock timer
			if dist2d > StudsBallDistance then
				IsFollowingBall=true; FollowLockUntil=0
			elseif dist2d < StudsBallDistance * 0.5 and now >= FollowLockUntil then
				IsFollowingBall=false; FollowLockUntil=now+0.35
			end

			local autoVec=(IsFollowingBall and dist2d>0.001) and md.Unit or Vector3.new(0,0,0)
			local finalDir=autoVec

			if isAnalogActive then
				local w=math.clamp(AnalogInterference/100,0,1)
				if w >= 0.5 then
					-- analógico domina: segue analógico, auto contribui só se não contradiz
					local blend=(w-0.5)*2
					if autoVec.Magnitude>0.001 then
						local dot=analogDir:Dot(autoVec)
						local autoContrib=dot>=0 and autoVec*(1-blend) or Vector3.new(0,0,0)
						finalDir=analogDir+autoContrib
					else
						finalDir=analogDir
					end
				else
					-- auto domina: analógico desvia levemente
					local blend=w*2
					if autoVec.Magnitude>0.001 then
						finalDir=autoVec+analogDir*blend*0.6
					else
						finalDir=analogDir*blend
					end
				end
				if finalDir.Magnitude>0.001 then finalDir=finalDir.Unit end
			end

			ProcessMovement(humanoid,finalDir,dt); wasControlling=true
			StatusLabel.Text="Auto Ball · "..AutoBallModes[GetABModeIdx()].." · "..MovementModes[GetMoveModeIdx()]; StatusLabel.TextColor3=Color3.fromRGB(0,255,100)
		else
			IsFollowingBall=false; FollowLockUntil=0
			if isAnalogActive then ProcessMovement(humanoid,analogDir,dt); StatusLabel.Text="Manual — fora da zona"; StatusLabel.TextColor3=Color3.fromRGB(0,200,255)
			else
				if wasControlling then wasControlling=false; CurrentMoveVector=Vector3.new(0,0,0); humanoid:Move(Vector3.new(0,0,0),false) end
				StatusLabel.Text="Aguardando entrar na zona"; StatusLabel.TextColor3=Color3.fromRGB(255,165,0)
			end
		end
	elseif isAnalogActive and humanoid then
		ProcessMovement(humanoid,analogDir,dt); wasControlling=true
		StatusLabel.Text="Manual · "..MovementModes[GetMoveModeIdx()]; StatusLabel.TextColor3=Color3.fromRGB(0,200,255)
	else
		IsFollowingBall=false; FollowLockUntil=0
		if wasControlling then
			wasControlling=false; CurrentMoveVector=Vector3.new(0,0,0)
			if humanoid then humanoid:Move(Vector3.new(0,0,0),false) end
		end
		if not CurrentBall then StatusLabel.Text="Procurando bola..."; StatusLabel.TextColor3=Color3.fromRGB(255,100,100)
		elseif not AutoBallEnabled then StatusLabel.Text="Bola: "..CurrentBall.Name; StatusLabel.TextColor3=Color3.fromRGB(0,255,255) end
	end
end)

