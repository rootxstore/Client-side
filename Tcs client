local function LaunchMain()
	TweenService:Create(AuthFrame,TweenInfo.new(0.4,Enum.EasingStyle.Quad),{BackgroundTransparency=1}):Play()
	TweenService:Create(AuthCard,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.new(0,0,0,0),Position=UDim2.new(0.5,0,0.5,0)}):Play()
	task.wait(0.45); AuthFrame:Destroy(); OpenBtn.Visible=true
end

local function AuthErr(msg)
	AuthStatus.Text=msg; AuthStatus.TextColor3=Color3.fromRGB(255,65,65)
	TweenService:Create(AuthCard,TweenInfo.new(0.055,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,5,true),{Position=UDim2.new(0.5,-165,0.5,-195)}):Play()
end

AuthBtn.MouseButton1Click:Connect(function()
	local nick=NickInput.Text:match("^%s*(.-)%s*$")
	local key=KeyInput.Text:match("^%s*(.-)%s*$")
	if #nick<3 then AuthErr("Nick muito curto."); return end
	if not VALID_KEYS[key] then AuthErr("Key inválida."); return end
	if string.lower(LocalPlayer.Name)~=string.lower(nick) then AuthErr("Nick não bate com a conta Roblox."); return end
	local sKey,sNick,sHwid=ReadSession()
	if sKey==key then
		if sNick and string.lower(sNick)~=string.lower(nick) then AuthErr("Key em uso com outro nick."); return end
		if sHwid and sHwid~=deviceHWID then AuthErr("Key em uso em outro dispositivo."); return end
	end
	WriteSession(key,nick,deviceHWID)
	AuthBtn.Text="✓  Autenticado"; AuthBtn.BackgroundColor3=Color3.fromRGB(0,175,80)
	AuthStatus.Text="Bem-vindo, "..nick.." !"; AuthStatus.TextColor3=Color3.fromRGB(0,220,110)
	task.wait(0.8); LaunchMain()
end)

task.spawn(function()
	task.wait(0.1)
	local sk,sn,sh=ReadSession()
	if sk and VALID_KEYS[sk] and sn and sh==deviceHWID and string.lower(LocalPlayer.Name)==string.lower(sn) then
		NickInput.Text=sn; KeyInput.Text=sk
		AuthStatus.Text="Sessão restaurada · "..sn; AuthStatus.TextColor3=Color3.fromRGB(0,195,110)
		task.wait(0.5); LaunchMain()
	end
end)
