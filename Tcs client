-- FUNÇÕES DE SUPORTE E PREDICT
---------------------------------------------------------
local function IsPlayerInZone(ballPos, targetPos, size)
	return math.abs(targetPos.X - ballPos.X) <= (size.X / 2) and
	       math.abs(targetPos.Y - ballPos.Y) <= (size.Y / 2) and
	       math.abs(targetPos.Z - ballPos.Z) <= (size.Z / 2)
end

local function CalculateLandingPosition(ball)
	local p0 = ball.Position
	local v0 = ball.AssemblyLinearVelocity
	local g = Workspace.Gravity
	
	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {ball, LocalPlayer.Character}
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local ray = Workspace:Raycast(p0, Vector3.new(0, -300, 0), rayParams)
	local floorY = ray and ray.Position.Y or (p0.Y - 3)
	
	if p0.Y <= floorY + 1 or math.abs(v0.Y) < 0.2 then
		return Vector3.new(p0.X, floorY + 0.1, p0.Z)
	end
	
	local dy = p0.Y - floorY
	local a = -0.5 * g
	local b = v0.Y
	local c = dy
	local discriminant = b*b - 4*a*c
	if discriminant < 0 then return p0 end
	
	local t1 = (-b + math.sqrt(discriminant)) / (2*a)
	local t2 = (-b - math.sqrt(discriminant)) / (2*a)
	local t = math.max(t1, t2)
	if t < 0 then return p0 end
	
	return Vector3.new(p0.X + (v0.X * t), floorY + 0.1, p0.Z + (v0.Z * t))
end

local function GetTPSActiveFoot(char)
	if not char then return nil end
	local footObj = char:FindFirstChild("Foot") or LocalPlayer:FindFirstChild("Foot") or (char:FindFirstChild("Values") and char.Values:FindFirstChild("Foot"))
	if footObj and (footObj:IsA("StringValue") or footObj:IsA("ValueObject")) then
		local val = string.upper(tostring(footObj.Value))
		if string.find(val, "RIGHT") or string.find(val, "DIREITA") or val == "R" then
			return "RIGHT"
		elseif string.find(val, "LEFT") or string.find(val, "ESQUERDA") or val == "L" then
			return "LEFT"
		end
	end
	return nil
end

local function TriggerAutoSwag()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not CurrentBall then return end
	
	if (CurrentBall.Position - root.Position).Magnitude <= 18 then
		local relativePos = root.CFrame:PointToObjectSpace(CurrentBall.Position)
		local desiredFoot = (relativePos.X >= 0) and "RIGHT" or "LEFT"
		local activeFoot = GetTPSActiveFoot(char) or CurrentTrackedFoot
		
		if desiredFoot ~= activeFoot and tick() - LastSwagTime > 0.35 then
			LastSwagTime = tick()
			CurrentTrackedFoot = desiredFoot
			task.spawn(function()
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game)
				task.wait(0.05)
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
			end)
		end
	end
end

