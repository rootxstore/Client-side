	local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(0.72,0,1,0); lbl.Position=UDim2.new(0,10,0,0); lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=Color3.fromRGB(195,212,232); lbl.Font=Enum.Font.Gotham; lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.ZIndex=13; lbl.Parent=row
	local pill=Instance.new("Frame"); pill.Size=UDim2.new(0,48,0,24); pill.Position=UDim2.new(1,-58,0.5,-12); pill.BackgroundColor3=Color3.fromRGB(48,52,68); pill.ZIndex=13; pill.Parent=row; Instance.new("UICorner",pill).CornerRadius=UDim.new(1,0)
	local dot=Instance.new("Frame"); dot.Size=UDim2.new(0,18,0,18); dot.Position=UDim2.new(0,3,0.5,-9); dot.BackgroundColor3=Color3.fromRGB(110,125,148); dot.ZIndex=14; dot.Parent=pill; Instance.new("UICorner",dot).CornerRadius=UDim.new(1,0)
	local state=false
	local callbacks={}
	local function SetState(v)
		state=v
		TweenService:Create(pill,TweenInfo.new(0.17),{BackgroundColor3=v and Color3.fromRGB(0,145,255) or Color3.fromRGB(48,52,68)}):Play()
		TweenService:Create(dot,TweenInfo.new(0.17),{Position=v and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9), BackgroundColor3=v and Color3.fromRGB(255,255,255) or Color3.fromRGB(110,125,148)}):Play()
		TweenService:Create(rs,TweenInfo.new(0.17),{Color=v and Color3.fromRGB(0,100,200) or Color3.fromRGB(28,42,68)}):Play()
		for _,cb in ipairs(callbacks) do cb(v) end
	end
	row.MouseButton1Click:Connect(function() SetState(not state) end)
	local getter = function() return state end
	local function OnChange(cb) table.insert(callbacks,cb) end
