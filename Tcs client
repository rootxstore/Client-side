local function ProcessMovement(humanoid, targetDir, dt)
	if not humanoid then return end
	local mode=MovementModes[GetMoveModeIdx()]
	if targetDir.Magnitude<0.001 then CurrentMoveVector=Vector3.new(0,0,0)
	else
		if mode=="Normal" then CurrentMoveVector=targetDir
		elseif mode=="Suave" then CurrentMoveVector=CurrentMoveVector:Lerp(targetDir,math.clamp(dt*6,0,1))
		elseif mode=="Fluida" then CurrentMoveVector=CurrentMoveVector:Lerp(targetDir,math.clamp(dt*12,0,1)) end
		if CurrentMoveVector.Magnitude>1 then CurrentMoveVector=CurrentMoveVector.Unit end
	end
	humanoid:Move(CurrentMoveVector,false)
end

local function IsInZone(bp,tp,sz)
	return math.abs(tp.X-bp.X)<=(sz.X/2) and math.abs(tp.Y-bp.Y)<=(sz.Y/2) and math.abs(tp.Z-bp.Z)<=(sz.Z/2)
end

local function CalcLanding(ball)
	local p0=ball.Position; local v0=ball.AssemblyLinearVelocity; local g=Workspace.Gravity
	local rp=RaycastParams.new(); rp.FilterDescendantsInstances={ball,LocalPlayer.Character}; rp.FilterType=Enum.RaycastFilterType.Exclude
	local ray=Workspace:Raycast(p0,Vector3.new(0,-300,0),rp)
	local fy=ray and ray.Position.Y or (p0.Y-3)
	if p0.Y<=fy+1 or math.abs(v0.Y)<0.2 then return Vector3.new(p0.X,fy+0.1,p0.Z) end
	local a=-0.5*g; local b=v0.Y; local c=p0.Y-fy
	local disc=b*b-4*a*c; if disc<0 then return p0 end
	local t=math.max((-b+math.sqrt(disc))/(2*a),(-b-math.sqrt(disc))/(2*a))
	if t<0 then return p0 end
	return Vector3.new(p0.X+v0.X*t, fy+0.1, p0.Z+v0.Z*t)
end

local function BallHigherThanPlayer()
	if not CurrentBall then return false end
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	return CurrentBall.Position.Y > (hrp.Position.Y + 1.5)
end

local function TriggerAutoSwag()
	local char=LocalPlayer.Character; local root=char and char:FindFirstChild("HumanoidRootPart")
	if not root or not CurrentBall then return end
	if (CurrentBall.Position-root.Position).Magnitude>18 then return end
	local rel=root.CFrame:PointToObjectSpace(CurrentBall.Position)
	local desired=(rel.X>=0) and "RIGHT" or "LEFT"
	local footObj=char:FindFirstChild("Foot") or (char:FindFirstChild("Values") and char.Values:FindFirstChild("Foot"))
	local active=CurrentTrackedFoot
	if footObj then
		local v=string.upper(tostring(footObj.Value))
		if string.find(v,"RIGHT") or v=="R" then active="RIGHT" elseif string.find(v,"LEFT") or v=="L" then active="LEFT" end
	end
	if desired~=active and tick()-LastSwagTime>0.35 then
		LastSwagTime=tick(); CurrentTrackedFoot=desired
		task.spawn(function()
			VirtualInputManager:SendKeyEvent(true,Enum.KeyCode.LeftControl,false,game)
			task.wait(0.05)
			VirtualInputManager:SendKeyEvent(false,Enum.KeyCode.LeftControl,false,game)
		end)
	end
end

