	local num = tonumber(ReachSizeInput.Text)
	ReachSize = num and Vector3.new(num, 5, num) or Vector3.new(15, 5, 15)
	if not num then ReachSizeInput.Text = "15" end
end)

AnalogInterferenceInput.FocusLost:Connect(function()
	local cleanedText = string.gsub(AnalogInterferenceInput.Text, "%%", "")
	local num = tonumber(cleanedText)
	if num then
		AnalogInterference = math.clamp(num, 1, 100)
		AnalogInterferenceInput.Text = tostring(AnalogInterference) .. "%"
	else
		AnalogInterferenceInput.Text = tostring(AnalogInterference) .. "%"
	end
end)

StudsBallInput.FocusLost:Connect(function()
	local num = tonumber(StudsBallInput.Text)
	if num then
		StudsBallDistance = math.max(0, num)
		StudsBallInput.Text = tostring(StudsBallDistance)
	else
		StudsBallInput.Text = tostring(StudsBallDistance)
	end
end)

local Colors = {
	{Name = "Ciano", Color = Color3.fromRGB(0, 255, 255)},
	{Name = "Verde", Color = Color3.fromRGB(0, 255, 0)},
	{Name = "Rosa", Color = Color3.fromRGB(255, 0, 255)},
	{Name = "Amarelo", Color = Color3.fromRGB(255, 255, 0)},
	{Name = "Branco", Color = Color3.fromRGB(255, 255, 255)}
}
local ColorIndex = 1

ColorBtn.MouseButton1Click:Connect(function()
	ColorIndex = (ColorIndex % #Colors) + 1
	ReachColor = Colors[ColorIndex].Color
	ColorBtn.Text = "Cor Hitbox (" .. Colors[ColorIndex].Name .. ")"
end)
