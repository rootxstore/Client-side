local DraggingAnalog = false
local IsAnalogTouch = false
local AnalogTouchObject = nil
local AnalogMoveVector = Vector3.new(0, 0, 0)

AnalogBase.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		DraggingAnalog = true
		AnalogTouchObject = input
		IsAnalogTouch = (input.UserInputType == Enum.UserInputType.Touch)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if DraggingAnalog then
		local valid = false
		if IsAnalogTouch then
			valid = (input == AnalogTouchObject)
		else
			valid = (input.UserInputType == Enum.UserInputType.MouseMovement)
		end
		
		if valid then
			local center = AnalogBase.AbsolutePosition + (AnalogBase.AbsoluteSize / 2)
			local delta = Vector2.new(input.Position.X - center.X, input.Position.Y - center.Y)
			local maxRadius = AnalogBase.AbsoluteSize.X / 2
			local distance = math.min(delta.Magnitude, maxRadius)
			local dir = delta.Magnitude > 0 and delta.Unit or Vector2.new(0, 0)
			
			local thumbOffset = dir * distance
			AnalogThumb.Position = UDim2.new(0.5, thumbOffset.X - 18, 0.5, thumbOffset.Y - 18)
			AnalogMoveVector = Vector3.new(dir.X, 0, dir.Y)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if DraggingAnalog then
		local valid = false
		if IsAnalogTouch then
			valid = (input == AnalogTouchObject)
		else
			valid = (input.UserInputType == Enum.UserInputType.MouseButton1)
		end
		
		if valid then
			DraggingAnalog = false
			AnalogTouchObject = nil
			AnalogThumb.Position = UDim2.new(0.5, -18, 0.5, -18)
			AnalogMoveVector = Vector3.new(0, 0, 0)
		end
	end
end)

