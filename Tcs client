-- SISTEMA DE BUSCA DE BOLA COM CACHE (OTIMIZADO)
---------------------------------------------------------
local CachedBalls = {}

local function RefreshBallCache()
	table.clear(CachedBalls)
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("Model") then
			local nameLower = string.lower(obj.Name)
			if string.find(nameLower, "tps") or nameLower == "ball" or nameLower == "football" then
				if not obj:FindFirstAncestorOfClass("Model") or not Players:GetPlayerFromCharacter(obj:FindFirstAncestorOfClass("Model")) then
					local part = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
					if part then
						table.insert(CachedBalls, part)
					end
				end
			end
		end
	end
end

task.spawn(function()
	while true do
		RefreshBallCache()
		task.wait(3)
	end
end)

local function ScanForClosestTPSBall()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return CachedBalls[1] end

	local closestBall = nil
	local shortestDistance = math.huge

	for _, part in ipairs(CachedBalls) do
		if part and part.Parent then
			local dist = (part.Position - hrp.Position).Magnitude
			if dist < shortestDistance then
				shortestDistance = dist
				closestBall = part
			end
		end
	end
	return closestBall
end

---------------------------------------------------------
-- LÓGICA DOS MODOS DE MOVIMENTAÇÃO (CORRIGIDA PARA NÃO ENGASGAR/DERRAPAR)
---------------------------------------------------------
local function ProcessMovement(humanoid, targetDir, dt)
	if not humanoid then return end
	local mode = MovementModes[MovementModeIndex]

	-- Se o vetor alvo for zero, zera instantaneamente para evitar deslizamentos/tremores
	if targetDir.Magnitude < 0.001 then
		CurrentMoveVector = Vector3.new(0, 0, 0)
	else
		if mode == "Normal" then
			CurrentMoveVector = targetDir
		elseif mode == "Suave" then
			CurrentMoveVector = CurrentMoveVector:Lerp(targetDir, math.clamp(dt * 6, 0, 1))
		elseif mode == "Fluida" then
			CurrentMoveVector = CurrentMoveVector:Lerp(targetDir, math.clamp(dt * 12, 0, 1))
		end
		
		if CurrentMoveVector.Magnitude > 1 then
			CurrentMoveVector = CurrentMoveVector.Unit
		end
	end

	humanoid:Move(CurrentMoveVector, false)
end

