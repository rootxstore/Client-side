local function MakeToggle(parent, label, order)
	local row=Instance.new("TextButton")
	row.Size=UDim2.new(0.98,0,0,40); row.BackgroundColor3=Color3.fromRGB(17,19,27)
	row.Text=""; row.AutoButtonColor=false; row.LayoutOrder=order; row.ZIndex=12; row.Parent=parent
