local CachedBalls={}
local function RefreshBallCache()
	table.clear(CachedBalls)
	for _,obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("Model") then
			local nl=string.lower(obj.Name)
			if string.find(nl,"tps") or nl=="ball" or nl=="football" then
				if not obj:FindFirstAncestorOfClass("Model") or not Players:GetPlayerFromCharacter(obj:FindFirstAncestorOfClass("Model")) then
					local part=obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
					if part then table.insert(CachedBalls,part) end
				end
			end
		end
	end
end
task.spawn(function() while true do RefreshBallCache(); task.wait(3) end end)

local function ScanClosest()
	local char=LocalPlayer.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return CachedBalls[1] end
	local cl,sh=nil,math.huge
	for _,p in ipairs(CachedBalls) do
		if p and p.Parent then local d=(p.Position-hrp.Position).Magnitude; if d<sh then sh=d; cl=p end end
	end
	return cl
end

