local HWID_FILE    = "rootx_hwid.dat"
local SESSION_FILE = "rootx_session.dat"

local function GetOrCreateHWID()
	if isfile and isfile(HWID_FILE) then
		local s = readfile(HWID_FILE)
		if s and #s > 5 then return s end
	end
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	local r = ""
	for i=1,8 do r = r..string.sub(chars,math.random(1,#chars),math.random(1,#chars)) end
	local hwid = "ROOTX-HWID-"..r
	if writefile then writefile(HWID_FILE, hwid) end
	return hwid
end

local function IsHwidInList(hwid)
	for _,v in ipairs(VALID_HWIDS) do if v==hwid then return true end end
	return false
end

local function ReadSession()
	if isfile and isfile(SESSION_FILE) then
		local raw = readfile(SESSION_FILE)
		if raw and #raw>0 then
			local p = string.split(raw,"|")
			return p[1],p[2],p[3]
		end
	end
	return nil,nil,nil
end

local function WriteSession(key,nick,hwid)
	if writefile then writefile(SESSION_FILE, key.."|"..nick.."|"..hwid) end
end

